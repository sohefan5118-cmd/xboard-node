# 复制为 /root/xboard-universal.env，并执行 chmod 600
# 不要把真实 Token/密码提交到 Git 或写入命令行。

PANEL_URL='https://panel.example.com'
REDIS_ADDR='10.66.0.1:6379'
REDIS_PASSWORD='change-me'
CLAIM_TTL='300'
CLAIM_PREFIX='xboard:device-claim'
RELEASE_VERSION='v1.13-ipv4'
HEALTH_PORT='65530'
SSH_USER='root'

# 控制器模式需要 A/B/C_HOST；SSH key 必须已配置。
A_HOST='192.0.2.10'
B_HOST='192.0.2.11'
C_HOST='192.0.2.12'
A_SSH_PORT='22'
B_SSH_PORT='22'
C_SSH_PORT='22'

# machine 或 node；按实际面板绑定方式填写。
A_MODE='machine'
B_MODE='machine'
C_MODE='machine'
A_ID='1'
B_ID='2'
C_ID='3'

A_TOKEN='replace-a-token'
B_TOKEN='replace-b-token'
C_TOKEN='replace-c-token'

# node 模式时填写；machine 模式留空。
A_NODE_TYPE=''
B_NODE_TYPE=''
C_NODE_TYPE=''

# 新增任意单节点时使用以下变量；复制本文件后只保留通用配置和 NODE_*。
# 在新节点本机执行：
# XBOARD_ROLE=node bash xboard-universal-installer.sh --node --env /root/xboard-node.env
NODE_MODE='machine'
NODE_ID='4'
NODE_TOKEN='replace-new-node-token'
NODE_NODE_TYPE=''
